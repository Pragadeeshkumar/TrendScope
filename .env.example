# TrendScope Environment Configuration Example
# Copy this file to .env and fill in your API credentials.

# Academic Open Access APIs
OPENALEX_EMAIL=your_email@example.com
UNPAYWALL_EMAIL=your_email@example.com
CORE_API_KEY=your_core_api_key_here

# LLM Providers (Optional for cloud fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
GROQ_API_KEY_3=your_groq_api_key_3

# Local Offline Ollama Configuration (Default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
